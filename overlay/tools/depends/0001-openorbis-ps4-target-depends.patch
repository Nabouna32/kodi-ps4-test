diff --git a/tools/depends/configure.ac b/tools/depends/configure.ac
--- a/tools/depends/configure.ac
+++ b/tools/depends/configure.ac
@@ -275,6 +275,15 @@ case $host in
       use_linker=wasm-ld
     fi
   ;;
+  x86_64*-*-freebsd*)
+    use_toolchain="${use_toolchain:-/opt/OpenOrbis/PS4Toolchain}"
+    platform_cc=clang
+    platform_cxx=clang++
+    platform_tool_prefix=llvm-
+    platform_additional_path="$use_toolchain/bin/linux"
+    if test "$use_linker_explicit" != "yes"; then
+      use_linker=ld.lld
+    fi
+  ;;
   *darwin*)
     # Again we set CC to find toolchain path for use in AC_PATH_TOOL macros further down
@@ -410,6 +419,18 @@ case $host in
     target_platform="wasm"
     app_rendersystem="gles"
     #emscripten builds are always cross
     cross_compiling="yes"
     has_zlib=0
     platform_cflags="-fPIC -pthread"
     platform_cxxflags="$platform_cflags"
     optimize_flags="-O2"
     platform_ldflags="-pthread"
     ffmpeg_options_default="--disable-asm --disable-x86asm --disable-inline-asm --disable-programs --enable-cross-compile --target-os=none --arch=wasm32"
   ;;
+  x86_64*-*-freebsd*)
+    if test "x$use_cpu" = "xauto"; then
+      use_cpu="x86_64"
+    fi
+    meson_cpu="x86_64"
+    meson_system="freebsd"
+    platform_os="freebsd"
+    target_platform="ps4"
+    platform_cflags="--target=x86_64-pc-freebsd12-elf -fPIC -funwind-tables -isysroot $use_toolchain -isystem $use_toolchain/include"
+    platform_cxxflags="$platform_cflags -isystem $use_toolchain/include/c++/v1"
+    optimize_flags="-O2"
+    platform_ldflags="--target=x86_64-pc-freebsd12-elf -fuse-ld=ld.lld -nostdlib -pie -Wl,--script=$use_toolchain/link.x -Wl,--eh-frame-hdr -L$use_toolchain/lib $use_toolchain/lib/crt1.o -lc -lkernel -lc++"
+  ;;
   *darwin*)
     # darwin builds are always cross
@@ -603,6 +624,8 @@ case $use_platform in
     ;;
   webos)
     ;;
+  ps4)
+    ;;
   wasm)
     ;;
   auto)
diff --git a/tools/depends/target/Toolchain.cmake.in b/tools/depends/target/Toolchain.cmake.in
--- a/tools/depends/target/Toolchain.cmake.in
+++ b/tools/depends/target/Toolchain.cmake.in
@@ -28,6 +28,11 @@ elseif(OS STREQUAL darwin_embedded)
   else()
     set(CORE_PLATFORM_NAME ios)
   endif()
+elseif(OS STREQUAL freebsd)
+  set(CMAKE_SYSTEM_NAME FreeBSD)
+  set(CORE_SYSTEM_NAME ps4)
+  set(CORE_PLATFORM_NAME ps4)
+  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
 elseif(OS STREQUAL wasm)
   set(CMAKE_SYSTEM_NAME Emscripten)
   set(CORE_SYSTEM_NAME wasm)
